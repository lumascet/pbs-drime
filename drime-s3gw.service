[Unit]
Description=S3 gateway to Drime for Proxmox Backup Server
Wants=network-online.target
After=network-online.target
Before=proxmox-backup-proxy.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/drime-s3gw -c /etc/drime-s3gw/config.toml serve
Restart=on-failure
RestartSec=5
StateDirectory=drime-s3gw
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/drime-s3gw

[Install]
WantedBy=multi-user.target
